# Unisocials — environment template
# Copy this file to `.env` and fill in your real values. `.env` is gitignored.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — BUYER TICKETS (Brevo — no domain needed)
# ─────────────────────────────────────────────────────────────────────────────
# Get a FREE key at https://app.brevo.com → SMTP & API → API Keys
# Then verify your sender email at https://app.brevo.com → Senders
# (click the verification link Brevo emails to that inbox).
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=support.sbiamautos@gmail.com
BREVO_SENDER_NAME=Unisocials

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — ADMIN ALERTS (Resend — only needs to reach YOUR inbox)
# ─────────────────────────────────────────────────────────────────────────────
# Get a key at https://resend.com — free tier allows sending to your own address
# in test mode (that's all you need for admin alerts).
RESEND_API_KEY=re_your_resend_key_here
ADMIN_EMAIL=soludobenedict5@gmail.com
EMAIL_FROM=Unisocials <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS (Flutterwave)
# ─────────────────────────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_hash_here

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_me_strong_password

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (optional — defaults to JSON files in ./data if unset)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

