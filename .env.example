# ─────────────────────────────────────────────────────────────────────────
# Unisocials — Environment Variables
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development and fill in your real values.
# NEVER commit `.env` — it holds live secrets (gitignored).
#
# On Render, set these SAME variables in the dashboard:
#   Render → unisocials → Environment → Env Vars
# ─────────────────────────────────────────────────────────────────────────

# ── Server ──
PORT=3000
SITE_URL=https://unisocials.onrender.com

# ── Storage ──
# PostgreSQL connection string (Neon recommended). If unset, server falls back
# to JSON files in ./data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── WhatsApp / Contact ──
WHATSAPP_FLOAT_NUMBER=2348122104576
WHATSAPP_ORDER_NUMBER=2348122104576
CONTACT_EMAIL=support.sbiamautos@gmail.com
FORMSUBMIT_KEY=support.sbiamautos@gmail.com
REDIRECT_URL=https://unisocials.onrender.com/thank-you.html

# ── Admin ──
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_EMAIL=soludobenedict5@gmail.com

# ── Flutterwave (=== SECRET, KEEP PRIVATE ===) ──
# Get yours at https://dashboard.flutterwave.com → Settings → API Keys
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_HASH=YOUR_WEBHOOK_SECRET_HASH
FLUTTERWAVE_BANK_NAME=Flutterwave MfB (formerly ok mfb)
FLUTTERWAVE_ACCOUNT_NUMBER=9707788756

# ── Email (=== SECRET, KEEP PRIVATE ===) ──
# Resend key — admin alerts (get at https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Brevo key — buyer ticket emails (get at https://app.brevo.com → SMTP & API)
BREVO_API_KEY=your_brevo_smtp_api_key
BREVO_SENDER_EMAIL=support.sbiamautos@gmail.com
BREVO_SENDER_NAME=Unisocials
EMAIL_FROM=Unisocials <onboarding@resend.dev>
