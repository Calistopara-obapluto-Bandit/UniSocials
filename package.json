{
  "name": "unisocials",
  "version": "2.0.0",
  "description": "Unisocials — Event Ticket Selling Platform for University of Nigeria (Flutterwave-only, accounts, per-ticket QR codes, PostgreSQL persistence)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:legacy && npm run build:react",
    "build:legacy": "node build.js",
    "build:react": "vite build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "unn",
    "socials",
    "tickets",
    "events",
    "flutterwave",
    "qr",
    "postgresql"
  ],
  "license": "MIT",
  "dependencies": {
    "pg": "^8.11.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "terser": "^5.51.2",
    "vite": "^8.3.2"
  }
}
